{
  "name": "vortex-engine",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:services": "docker compose up -d",
    "stop:services": "docker compose down",
    "db:schema:push": "npx drizzle-kit push",
    "db:migration:generate": "npx drizzle-kit generate",
    "db:migration:apply": "npx drizzle-kit migrate",
    "db:seed": "tsx src/core/db/seed.ts",
    "db:verify": "tsx src/core/db/verify.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.2",
    "hono-pino": "^0.10.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "@types/node": "^26.2.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}