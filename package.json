{
  "name": "vortex-engine",
  "type": "module",
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=.env.development tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:services": "docker compose --env-file .env.development up -d --wait",
    "stop:services": "docker compose --env-file .env.development down",
    "db:schema:push": "DOTENV_CONFIG_PATH=.env.development drizzle-kit push",
    "db:migration:generate": "DOTENV_CONFIG_PATH=.env.development drizzle-kit generate",
    "db:migration:apply": "DOTENV_CONFIG_PATH=.env.development drizzle-kit migrate",
    "db:seed": "DOTENV_CONFIG_PATH=.env.development tsx src/core/db/seed.ts",
    "db:verify": "DOTENV_CONFIG_PATH=.env.development tsx src/core/db/verify.ts",
    "test:pricing": "tsx src/core/pricing.test.ts",
    "test:api": "DOTENV_CONFIG_PATH=.env.development tsx src/core/db/test-api.ts",
    "setup:local": "pnpm start:services && pnpm db:migration:apply && pnpm db:seed && pnpm db:verify"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.2",
    "hono-pino": "^0.10.3",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "@types/node": "^26.2.0",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}